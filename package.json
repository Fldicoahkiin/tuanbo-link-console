{
  "name": "tuanbo-yijianchufa",
  "private": true,
  "version": "0.4.41",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @tb/desktop dev",
    "build": "pnpm --filter @tb/desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --ignore-pattern eslint.config.mjs",
    "test": "pnpm test:release && node tools/ibt/build.mjs && vitest run",
    "test:release": "node --test scripts/release-config.test.mjs",
    "release:check": "node scripts/verify-release-version.mjs",
    "dist:dir": "pnpm --filter @tb/desktop dist:dir",
    "dist": "pnpm --filter @tb/desktop dist",
    "verify": "pnpm release:check && pnpm typecheck && pnpm test && pnpm lint && pnpm build && node scripts/verify-desktop-artifacts.mjs",
    "verify:release": "pnpm verify && pnpm dist && node scripts/verify-desktop-artifacts.mjs --dist && pnpm release:manifest",
    "verify:installer": "pwsh -NoLogo -NoProfile -File scripts/verify-windows-installer.ps1",
    "release:manifest": "node scripts/write-release-manifest.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.8.1",
    "electron": "39.8.10",
    "esbuild": "0.28.1",
    "eslint": "^9.39.1",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "js-yaml": "4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "4.1.11",
    "zod": "^4.1.12"
  },
  "pnpm": {
    "patchedDependencies": {
      "extract-zip@2.0.1": "patches/extract-zip@2.0.1.patch"
    },
    "overrides": {
      "js-yaml": "4.3.2",
      "ws": "8.21.0",
      "vite": "7.3.5",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "tar": "7.5.21",
      "tmp@<0.2.7": "0.2.7",
      "@xmldom/xmldom@<0.8.15": "0.8.15",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "@babel/core@7": "7.29.6",
      "baseline-browser-mapping@2": "2.11.0",
      "browserslist@4": "4.28.7",
      "form-data@4": "4.0.6",
      "nanoid@3": "3.3.18",
      "postcss@8": "8.5.23"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "ffmpeg-static"
    ]
  }
}
