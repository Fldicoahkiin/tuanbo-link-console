+// Windows release archives contain regular files only. Never traverse links.
+async function rejectLinkComponents (root, target) {
+  const relative = path.relative(root, target)
+  if (path.isAbsolute(relative) || relative.split(path.sep).includes('..')) {
+    throw new Error('ZIP entry is outside the extraction directory')
+  }
+  let current = root
+  for (const component of relative.split(path.sep).filter(Boolean)) {
+    current = path.join(current, component)
+    const stat = await fs.lstat(current).catch(err => {
+      if (err.code === 'ENOENT') return null
+      throw err
+    })
+    if (stat && stat.isSymbolicLink()) throw new Error('ZIP extraction refuses symbolic links')
+  }
+}
