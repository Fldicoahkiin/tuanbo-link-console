{
  "name": "@tb/desktop",
  "private": true,
  "version": "0.4.57",
  "productName": "团播联动台",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "node ../../tools/obs/native-preview/build.mjs && node ../../tools/ibt/build.mjs && node ../../tools/midi-probe/build.mjs && node ../../tools/playback-engine/build.mjs && node ./scripts/run-dev.mjs",
    "build": "node ../../tools/obs/native-preview/build.mjs && node ../../tools/ibt/build.mjs && node ../../tools/midi-probe/build.mjs && node ../../tools/playback-engine/build.mjs && electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:e2e": "playwright test",
    "probe:midi": "node ./scripts/probe-windows-midi.mjs",
    "probe:mtc": "node ./scripts/probe-windows-mtc.mjs",
    "probe:mtc:send": "node ./scripts/send-windows-mtc.mjs",
    "probe:mtc:runtime": "node ./scripts/probe-link-mtc-runtime.mjs",
    "dist:dir": "node ../../tools/obs/native-preview/build.mjs && node ../../tools/ibt/build.mjs && node ../../tools/midi-probe/build.mjs && node ../../tools/playback-engine/build.mjs && electron-vite build --mode release && electron-builder --dir",
    "dist": "node ../../tools/obs/native-preview/build.mjs && node ../../tools/ibt/build.mjs && node ../../tools/midi-probe/build.mjs && node ../../tools/playback-engine/build.mjs && electron-vite build --mode release && electron-builder --publish never"
  },
  "build": {
    "productName": "团播联动台",
    "afterPack": "./scripts/edit-windows-executable.mjs",
    "appId": "com.tuanbo.control",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "files": [
      "out/**",
      "!out/**/*.map",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "buildResources": "build"
    },
    "publish": {
      "provider": "generic",
      "url": "https://updates.tuanbo-link.jinhefilm.com/windows/x64/"
    },
    "mac": {
      "icon": "build/icon.icns"
    },
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Tuanbo-Link-Console-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "packElevateHelper": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "团播联动台",
      "uninstallDisplayName": "团播联动台"
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "electronVersion": "39.8.10",
    "electronDist": "../../node_modules/electron/dist",
    "extraResources": [
      {
        "from": "../../tools/playback-engine/bin",
        "to": "playback-engine",
        "filter": [
          "tblink-playback.exe",
          "build.json"
        ]
      },
      {
        "from": "../../artifacts/beauty-prototype/plugin",
        "to": "beauty/plugin",
        "filter": [
          "tblink-beauty.dll",
          "beauty.effect"
        ]
      },
      {
        "from": "../../artifacts/beauty-prototype/runtime",
        "to": "beauty/runtime"
      },
      {
        "from": "../../artifacts/beauty-prototype/face_landmarker.task",
        "to": "beauty/face_landmarker.task"
      },
      {
        "from": "../../artifacts/beauty-prototype/face_detection_yunet_2023mar.onnx",
        "to": "beauty/face_detection_yunet_2023mar.onnx"
      },
      {
        "from": "../../tools/obs/beauty/YUNET_LICENSE.txt",
        "to": "beauty/YUNET_LICENSE.txt"
      },
      {
        "from": "../../artifacts/beauty-prototype/selfie_multiclass_256x256.onnx",
        "to": "beauty/selfie_multiclass_256x256.onnx"
      },
      {
        "from": "../../artifacts/beauty-prototype/selfie_skin_probability.onnx",
        "to": "beauty/selfie_skin_probability.onnx"
      },
      {
        "from": "../../artifacts/beauty-prototype/rtmdet-ins-tiny/raw-heads.onnx",
        "to": "beauty/rtmdet-ins-tiny/raw-heads.onnx"
      },
      {
        "from": "../../tools/obs/beauty/RTMDET_LICENSE.txt",
        "to": "beauty/RTMDET_LICENSE.txt"
      },
      {
        "from": "../../tools/obs/beauty/RTMDET_NOTICE.txt",
        "to": "beauty/RTMDET_NOTICE.txt"
      },
      {
        "from": "../../tools/obs/beauty/SEMANTIC_LICENSE.txt",
        "to": "beauty/SEMANTIC_LICENSE.txt"
      },
      {
        "from": "../../tools/obs/beauty/SEMANTIC_NOTICE.txt",
        "to": "beauty/SEMANTIC_NOTICE.txt"
      },
      {
        "from": "../../artifacts/beauty-prototype/pose_landmarker_lite.task",
        "to": "beauty/pose_landmarker_lite.task"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../tools/obs/native-preview/tblink-realtime-preview.dll",
        "to": "obs/tblink-realtime-preview.dll"
      },
      {
        "from": "../../tools/ibt/bin",
        "to": "ibt"
      },
      {
        "from": "../../tools/midi-probe/bin/tblink-midi-probe.exe",
        "to": "midi/tblink-midi-probe.exe"
      }
    ]
  },
  "dependencies": {
    "@tb/core": "workspace:*",
    "@tb/schema": "workspace:*",
    "@xmldom/xmldom": "0.9.12",
    "electron-updater": "6.8.9",
    "ffmpeg-static": "5.3.0",
    "lucide-react": "^0.460.0",
    "obs-websocket-js": "5.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wavesurfer.js": "^7.12.12",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron-builder": "26.15.3",
    "electron-vite": "^4.0.0",
    "esbuild": "0.28.1",
    "rcedit": "5.0.2",
    "vite": "7.3.5"
  },
  "description": "内部音乐主控与 P1 跟随双模式的 OBS、MIDI 时间线联动桌面端",
  "author": "团播联动台"
}
