{
  "name": "@tb/licensing-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js",
    "build:web": "node build-web.mjs",
    "build:console": "node build-console.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.60.0",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  }
