  "narrative": {
    "northStar": "制作设备手册",
    "overview": "以“制作设备手册”为视觉隐喻：银灰纸面、炭色文字、暖橙操作提示，配合接近直角的现场图像与稍圆的表单控件。中文标题清楚、有分量，正文保留系统字体的阅读习惯。\n\n信息按工作流分段，以留白和细线形成阅读秩序。界面跟随系统明暗偏好；暗色保留相同层级、形状与信息密度，不另造一套视觉语言。图像表达现场语境，生成图像须明确标注，不能承担真实产品界面或客户案例的证明。",
    "keyCharacteristics": [
      "银灰与炭色构成中性底色，暖橙承担操作与选中提示。",
      "标题使用自托管中文无衬线子集，正文使用系统中文字体。",
      "平面分区、细线边界、轻圆角控件，不使用投影。",
      "明暗主题保持布局一致，交互反馈简短且可减少。"
    ],
    "rules": [
      {
        "name": "The Single Accent Rule",
        "body": "可操作与选中状态共用暖橙；新增页面不得凭装饰需要另增品牌强调色。",
        "section": "colors"
      },
      {
        "name": "The Glyph Coverage Rule",
        "body": "标题字形由本地子集承载；改动标题后必须检查子集，不把后备字体混排当作已完成的排版。",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "常态与悬停均保持平面，不为卡片和按钮增加投影；交互反馈由颜色、焦点和短促按压表达。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 沿用语义 CSS 变量，使文字、边线、表面与焦点随系统明暗模式切换。",
      "Do 为可操作元素保留可见焦点，并用文字说明选中、不可售、加载与错误状态。",
      "Do 修改标题后检查字体子集覆盖；新增字形缺失时重新生成子集。",
      "Do 将生成图像的说明同时保留在替代文字与可见图注中。"
    ],
    "donts": [
      "Don't 为营销强调增加第二种品牌色、渐变光晕或卡片投影。",
      "Don't 将整页正文替换为标题子集字体，或让价格失去清楚的数字层级。",
      "Don't 用颜色作为套餐选中状态的唯一提示。",
      "Don't 将示意图当作软件截图或已经发生的客户现场。"
    ]
  }
}
