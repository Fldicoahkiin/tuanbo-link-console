# DNS must resolve to this server before Caddy can obtain public certificates.
api.tuanbo-link.jinhefilm.com {
    @public path /health /v1/activate /v1/catalog /v1/orders /v1/payments/alipay/notify /v1/payments/wechat/notify
    handle @public {
        reverse_proxy 127.0.0.1:8787 {
            header_up X-Tblink-Client-IP {http.request.remote.host}
        }
    }
    @delivery {
        method GET
        path_regexp delivery "^/v1/orders/[a-f0-9-]{36}$"
    }
    handle @delivery {
        reverse_proxy 127.0.0.1:8787 {
            header_up X-Tblink-Client-IP {http.request.remote.host}
        }
    }
    handle {
        respond "Not found" 404
    }
}

updates.tuanbo-link.jinhefilm.com {
    root * /srv/tblink-updates
    header X-Content-Type-Options nosniff
    @manifest path /windows/x64/latest.yml
    handle @manifest {
        header Cache-Control "no-store"
        file_server
    }
    @artifact path_regexp artifact ^/windows/x64/Tuanbo-Link-Console-[0-9]+\.[0-9]+\.[0-9]+-x64\.exe(\.blockmap)?$
    handle @artifact {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        respond "Not found" 404
    }
}

# Future product website: reserved hostname, no application or directory listing.
tuanbo-link.jinhefilm.com {
    respond "Not found" 404
}
