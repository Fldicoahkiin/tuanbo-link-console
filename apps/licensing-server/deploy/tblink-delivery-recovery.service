[Unit]
Description=Recover delivery of verified Tuanbo Alipay payments
After=tblink-licensing.service
Requisite=tblink-licensing.service

[Service]
Type=oneshot
User=tblink-license
Group=tblink-license
ExecStart=/usr/bin/python3 /opt/tblink-licensing/payment-exceptions.py --recover-batch
TimeoutStartSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tblink-licensing
MemoryMax=128M
