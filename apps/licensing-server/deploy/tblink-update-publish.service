[Unit]
Description=Publish or roll back the Windows update feed on a console request
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/tblink-licensing/publish-update.py --process-requests
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Writes only the feed, root's own /var/lib/tblink-update-publish (results, status, receipts, audit, lock, work
# copies) and the staging entries it publishes or discards. The console's request directory stays read-only.
# Each path is its own mount here: files move between them by copying, never by rename (EXDEV).
ReadOnlyPaths=/var/lib/tblink-licensing/update-requests
ReadWritePaths=/srv/tblink-updates/windows/x64 /var/lib/tblink-update-publish /var/lib/tblink-release/staging
