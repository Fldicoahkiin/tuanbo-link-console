LICENSE_HOST=127.0.0.1
LICENSE_PORT=8787
# Use loopback only after the local proxy overwrites X-Tblink-Client-IP on every API route.
LICENSE_PROXY_MODE=none
LICENSE_DATABASE=/var/lib/tblink-licensing/license.db
LICENSE_KEY_ID=release-1
LICENSE_PRIVATE_KEY_FILE=/etc/tblink-licensing/signing.pem
LICENSE_DATA_KEY_FILE=/etc/tblink-licensing/data-key.txt
LICENSE_ADMIN_TOKEN_FILE=/etc/tblink-licensing/admin-token.txt

# Optional: enable only after merchant/app approval and sandbox + controlled live acceptance.
# All three must be set together. This is Alipay's verification key, not the app's public key.
# ALIPAY_APP_ID=<16-digit-approved-app-id>
# ALIPAY_SELLER_ID=<16-digit-company-seller-id>
# ALIPAY_PUBLIC_KEY_FILE=/etc/tblink-licensing/alipay-public.pem

# Generating a payment link is separate from verifying notifications. Default remains closed.
# Enable only after product approval, checkout terms and controlled payment acceptance.
ALIPAY_CHECKOUT_ENABLED=false
# ALIPAY_PRIVATE_KEY_FILE=/etc/tblink-licensing/alipay-private.pem

# Public sales also require a separately approved catalog. Omit until prices/terms are confirmed.
# LICENSE_CATALOG_FILE=/etc/tblink-licensing/catalog.json
