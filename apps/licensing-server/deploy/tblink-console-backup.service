[Unit]
Description=Encrypted licensing console backup and offsite verification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/tblink-licensing/backup-console.py
TimeoutStartSec=900
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
